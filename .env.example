# Copy this file's structure into .env.development (committed) and
# .env.development.local (gitignored, for personal overrides).
#
# Loader: server/src/index.ts and drizzle.config.ts pick the file by
# `.env.${NODE_ENV}` (defaults to development).

NODE_ENV=development
PORT=3001

DATABASE_URL=postgres://postgres:mypassword@localhost:5432/postgres

# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-me

BETTER_AUTH_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

MET_USER_AGENT=minhytteapp/1.0 your.email@example.com

# Resend transactional email — only required in production. In development
# the magic-link handler console.logs the URL, so these can be left empty.
RESEND_API_KEY=
MAGIC_LINK_FROM=auth@minhytte.app
