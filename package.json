{
  "name": "minhytteapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "build": "tsc -b && vite build client",
    "dev": "vite client",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:all": "concurrently -n web,api -c cyan,magenta \"npm:dev\" \"npm:dev:server\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed:minimal": "tsx server/src/db/seed-minimal.ts",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "i18n:extract": "i18next-cli extract",
    "i18n:check": "i18next-cli extract --dry-run --ci",
    "lint:fix": "eslint --fix .",
    "lint": "eslint .",
    "preview": "vite preview client",
    "start": "tsx server/src/index.ts",
    "test": "vitest --run --config client/vite.config.ts",
    "test:e2e": "vitest --run --config client/vite.config.e2e.ts",
    "test:server": "vitest --run --config server/vitest.config.ts",
    "type-check": "tsc -b --noEmit"
  },
  "dependencies": {
    "@digdir/designsystemet-css": "^1.13.3",
    "@digdir/designsystemet-react": "^1.13.3",
    "@hono/node-server": "^2.0.2",
    "@hono/trpc-server": "^0.4.2",
    "@navikt/aksel-icons": "^8.11.0",
    "@portabletext/editor": "^7.0.0",
    "@portabletext/react": "^6.2.0",
    "@portabletext/toolbar": "^8.0.0",
    "@portabletext/types": "^4.0.2",
    "@tanstack/react-query": "^5.99.2",
    "@tanstack/react-query-devtools": "^5.99.2",
    "@tanstack/react-router": "^1.168.23",
    "@tanstack/react-router-devtools": "^1.166.13",
    "@trpc/client": "^11.16.0",
    "@trpc/server": "^11.16.0",
    "@trpc/tanstack-react-query": "^11.16.0",
    "better-auth": "^1.6.11",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "flatpickr": "^4.6.13",
    "hono": "^4.12.18",
    "i18next": "^26.2.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.8",
    "resend": "^6.12.4",
    "superjson": "^2.2.6",
    "temporal-polyfill": "^0.3.2",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@tanstack/router-plugin": "^1.167.22",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/eslint-plugin": "^1.1.39",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "i18next-cli": "^1.58.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.29.0",
    "vite": "^6.2.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.1.1",
    "workbox-window": "^7.4.1"
  }
}
