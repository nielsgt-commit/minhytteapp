# Local development values. This file is committed; treat the secret
# below as a placeholder for the local Postgres only — never reuse it
# elsewhere. Personal overrides go in .env.development.local (gitignored).

DATABASE_URL=postgres://postgres:mypassword@localhost:5432/postgres
BETTER_AUTH_SECRET=local-dev-placeholder-not-a-secret
BETTER_AUTH_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
MET_USER_AGENT=minhytteapp/1.0 weather@minhytte.app
