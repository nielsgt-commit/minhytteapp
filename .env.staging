# Staging environment — template only.
# Real values are set in Render's Environment dashboard for the staging service.
# This file documents the keys staging expects; keep it in sync.

NODE_ENV=staging
PORT=3001

# Render Postgres (Internal Database URL) — set in Render UI, not here
DATABASE_URL=

# Generate with: openssl rand -hex 32 — store in Render UI, not here
BETTER_AUTH_SECRET=

BETTER_AUTH_URL=https://stage.minhytte.app
CORS_ORIGIN=https://stage.minhytte.app

MET_USER_AGENT=minhytteapp/1.0 weather@minhytte.app
